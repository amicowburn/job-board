# =================================
# MMSS Job Board Environment Variables
# =================================
# Copy this file to .env.local and fill in your values

# ---------------------------------
# Supabase Configuration (Required)
# ---------------------------------
# Get these from your Supabase project settings > API

# Public URL - safe to expose to browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Anon Key - public key for client-side operations (RLS enforced)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service Role Key - NEVER expose to browser (bypasses RLS)
# Used for server-side operations like job sync
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------
# Application Configuration
# ---------------------------------
# Your deployed app URL (used for redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------
# Email (Resend) — for job submission notifications
# ---------------------------------
# Get your API key from https://resend.com
# Requires a verified sender domain (monashmss.com)
RESEND_API_KEY=re_your_api_key_here

# ---------------------------------
# Job Sync Configuration
# ---------------------------------
# Secret token to protect the sync endpoint
# Generate a random string: openssl rand -base64 32
SYNC_SECRET=your-sync-secret-here

# External Jobs API (optional - if using external job source)
EXTERNAL_JOBS_API_URL=
EXTERNAL_JOBS_API_KEY=

# Set to 'true' to mark jobs not seen in sync as inactive
MARK_MISSING_INACTIVE=true

# ---------------------------------
# Development Configuration
# ---------------------------------
# For local Supabase development (supabase start)
# Uncomment these when using Supabase local:
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<local-anon-key>
# SUPABASE_SERVICE_ROLE_KEY=<local-service-role-key>
